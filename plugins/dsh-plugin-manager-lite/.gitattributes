# 统一行尾：仓库内按 text 规范化，JS/JSON/MD/YML 用 LF
* text=auto

*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.ts    text eol=lf

*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
