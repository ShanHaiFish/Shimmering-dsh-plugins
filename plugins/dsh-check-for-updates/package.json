{
  "name": "dsh-check-for-updates",
  "version": "1.12.0",
  "description": "DSH 更新检查插件（静态 bundle）：首次打开自动检查 DSH 新版本（取 npm 实际最高版本），左下方弹窗提示并提供【更新到】按钮自动执行已校验升级；UI 使用 DSH 语义化主题 token；DSH 安装根/版本、node/npm 均在运行时探测，无硬编码路径。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "client", "cordis.patch.yml"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ShanHaiFish/dsh-check-for-updates.git" },
  "keywords": ["deepseek", "harness", "dsh", "dsh-plugin", "update", "updater", "version-check"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-cordis-host-runner": "^0.1.0-rc.6",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
